# Portas publicadas pelo Docker Compose.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Backend e worker devem apontar para o mesmo volume /data.
DATABASE_URL=sqlite:////data/transcricoes.db
UPLOAD_DIR=/data/uploads

MAX_UPLOAD_SIZE_MB=10
JOB_STALE_AFTER_MINUTES=30
WORKER_POLL_INTERVAL_SECONDS=1
RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=300
SQLITE_BUSY_TIMEOUT_MS=5000
UPLOAD_CHUNK_SIZE_BYTES=65536

# Deve acomodar o multipart além do tamanho máximo do PDF.
NGINX_CLIENT_MAX_BODY_SIZE=11m
